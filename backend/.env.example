APP_NAME=
APP_ENV=
# Left empty on purpose: start.sh runs `php artisan key:generate` on container start.
APP_KEY=
APP_DEBUG=
# Public URL of the stack (nginx is published on host port 8080).
APP_URL=
# Where emails / invitation redirects send the browser. Use http://localhost:5173
# instead if you run the Vite dev server rather than the Docker frontend.
FRONTEND_URL=

LOG_CHANNEL=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

# --- Database (must match the `db` service in docker-compose.yml) ---
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Redis: cache + queue ---
REDIS_CLIENT=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=
CACHE_DRIVER=
QUEUE_CONNECTION=
SESSION_DRIVER=
SESSION_LIFETIME=
FILESYSTEM_DISK=

# --- Real-time (Laravel Reverb) ---
# REVERB_APP_KEY must equal VITE_REVERB_APP_KEY in frontend/.env.production.
# The secret is server-side only; set it to any random string.
BROADCAST_DRIVER=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=

# --- Mail ---
# `log` writes emails to storage/logs/laravel.log so the app works with no SMTP account.
# Switch to `smtp` and fill in the values below (e.g. a Mailtrap sandbox) to send real mail.
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@timetracker.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Google Sign-In (optional) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials,
# add http://localhost:8080 as an authorized JavaScript origin, and set the same
# client id as VITE_CLIENT_ID in the frontend env files.
CLIENT_ID=
CLIENT_SECRET=

# --- Telescope debug dashboard (served at /telescope) ---
TELESCOPE_ENABLED=false
